<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.video.coupangm" name="CoupangPlay MINI" version="2.2.3a" provider-name="NightRain">
	<requires>
		<import addon="xbmc.python" version="3.0.0"/>
		<import addon="script.module.inputstreamhelper" version="0.5.0+matrix.1"/>
		<import addon="script.module.requests" version="2.22.0"/>
		<import addon="script.module.beautifulsoup4" version="4.6.3+matrix.1"/>
	</requires>
	<extension point="xbmc.python.pluginsource" library="coupangMain.py">
    	<provides>video</provides>
	</extension>
	<extension point="xbmc.addon.metadata">
		<summary lang="en_GB">Coupang Play for KODI</summary>
		<summary lang="ko_KR">Coupang Play for KODI</summary>
		<description lang="en_GB">Coupang Play service</description>
		<description lang="ko_KR">Coupang Play service</description>
		<language></language>
		<platform>all</platform>
		<assets>
			<icon>icon.png</icon>
		</assets>
	</extension>
</addon>
<addon id="service.ottsync" name="Kodi Settings Backup/Restore" version="1.00" provider-name="user">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="actions.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Manual Kodi settings backup/restore over Samba</summary>
    <description lang="en_GB">Backs up and restores Favourites and CarLinkKit-specific settings (GUI, skin) to/from a Samba server.</description>
    <platform>all</platform>
  </extension>
</addon>
<addon id="repository.7daysrepo" name="7Days Repo" version="1.0.0" provider-name="7777days">
  <requires>
    <import addon="xbmc.addon" version="12.0.0"/>
  </requires>
  <extension point="xbmc.addon.repository" name="7Days Repo">
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/7777days/7daysrepo/main/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/7777days/7daysrepo/main/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/7777days/7daysrepo/main/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Personal Kodi addon repository</summary>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
</addons>
