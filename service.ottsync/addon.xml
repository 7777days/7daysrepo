<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.ottsync" name="Kodi Settings Backup/Restore" version="1.00" provider-name="user">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="actions.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Manual Kodi settings backup/restore over Samba</summary>
    <description lang="en_GB">Backs up and restores Favourites and CarLinkKit-specific settings (GUI, skin) to/from a Samba server.</description>
    <platform>all</platform>
  </extension>
</addon>
